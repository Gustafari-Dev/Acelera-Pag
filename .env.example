# API/RAG local: sem chamada ao Google, download de modelo ou chave necessária.
# Os três agentes executam no Python; sem GOOGLE_API_KEY o fallback é automático.
# O n8n usa somente CENTRAL_API_URL e as variáveis do Workspace abaixo.
USE_MOCK_LLM=true
USE_MOCK_EMBEDDINGS=true
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=30
DATABASE_URL=sqlite:///./data/reembolsos.db
CHROMA_PERSIST_DIR=./data/chroma
POLICY_DOCS_DIR=./docs
LIMITE_ALCADA_AUTOMATICA=1000.00
AUTORIZACAO_TTL_SECONDS=900
APP_TIMEZONE=America/Sao_Paulo
SEED_DEMO_DATA=true
# false: só /casos/analisar autoriza execuções (pareceres vêm dos agentes do backend).
PERMITIR_VALIDAR_EXTERNO=false
# Usadas pelo n8n; o backend não acessa Drive, Sheets ou Gmail diretamente.
# Docker Desktop: host.docker.internal. n8n nativo: http://127.0.0.1:8000
CENTRAL_API_URL=http://host.docker.internal:8000
GOOGLE_DRIVE_BRONZE_FOLDER_ID=
GOOGLE_DRIVE_SILVER_FOLDER_ID=
GOOGLE_SHEETS_GOLD_ID=
GOOGLE_SHEETS_GOLD_TAB=Reembolsos
EQUIPE_EMAIL=
