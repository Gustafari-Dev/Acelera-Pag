    {
      "id": "5d0368ab-101f-5b1c-bba0-dd82265dc408",
      "name": "Gerar caso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Um evento por execução. O payload original permanece separado dos dados normalizados.\nconst { randomUUID } = require('crypto');\nconst item = $input.first();\nconst bruto = item.json.body ?? item.json;\nconst config = {\n  api_url: ($env.CENTRAL_API_URL || 'http://host.docker.internal:8000').replace(/\\/$/, ''),\n  bronze_folder: $env.GOOGLE_DRIVE_BRONZE_FOLDER_ID || '',\n  silver_folder: $env.GOOGLE_DRIVE_SILVER_FOLDER_ID || '',\n  gold_sheet: $env.GOOGLE_SHEETS_GOLD_ID || '',\n  gold_tab: $env.GOOGLE_SHEETS_GOLD_TAB || 'Reembolsos',\n  equipe_email: $env.EQUIPE_EMAIL || '',\n};\nfor (const key of ['bronze_folder', 'silver_folder', 'gold_sheet']) {\n  if (!config[key]) throw new Error(`Configuração obrigatória ausente: ${key}`);\n}\nreturn [{ json: {\n  bruto, case_id: bruto.case_id || randomUUID(), config,\n  recebido_em: new Date().toISOString(), origem: 'webhook',\n}, binary: item.binary }];\n"
      }
    },
    {
      "id": "cf9225bd-6d85-5d18-aa9c-4f68e3c103e6",
      "name": "Preparar Bronze",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst ctx = item.json;\nconst prefixo = `${ctx.recebido_em.slice(0, 10)}_${ctx.origem}_${ctx.case_id}`;\nconst itens = [{\n  json: { nome_arquivo: `${prefixo}_evento.json` },\n  binary: { data: {\n    data: Buffer.from(JSON.stringify(ctx.bruto, null, 2), 'utf8').toString('base64'),\n    mimeType: 'application/json', fileName: `${prefixo}_evento.json`,\n  } },\n}];\nfor (const [campo, arquivo] of Object.entries(item.binary || {})) {\n  const nome = String(arquivo.fileName || campo).replace(/[^a-zA-Z0-9._-]/g, '_');\n  itens.push({\n    json: { nome_arquivo: `${prefixo}_${campo}_${nome}` },\n    binary: { data: arquivo },\n  });\n}\nreturn itens;\n"
      }
    },
    {
      "id": "3128d911-9d15-550e-afc9-51403f754243",
      "name": "Salvar Bronze",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $json.nome_arquivo }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
